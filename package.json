{
  "name": "livechat-app",
  "version": "1.0.0",
  "description": "Real-time chat application - MERN Stack",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w packages/client",
    "dev:server": "npm run dev -w packages/server",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build -w packages/client",
    "build:server": "npm run build -w packages/server",
    "start:server": "npm run start -w packages/server",
    "test:server": "npm test -w packages/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
